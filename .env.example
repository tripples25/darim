# Copy to .env; generate secrets with: openssl rand -hex 32
DOMAIN=wishlist.example.com
POSTGRES_PASSWORD=
AUTH_SIGNING_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Off-server S3-compatible backup destination; use a dedicated bucket/prefix.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=wishlist-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
