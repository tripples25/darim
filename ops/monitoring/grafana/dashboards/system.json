{
  "uid": "darim-system",
  "title": "Дарим · Система VPS",
  "description": "Ресурсы хоста VPS и доступность сбора node_exporter.",
  "tags": ["darim", "system", "prometheus"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Сбор метрик",
      "description": "Доступность node_exporter для Prometheus.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "up{job=\"darim-system\"}", "legendFormat": "node_exporter", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "Недоступен", "color": "red" }, "1": { "text": "Работает", "color": "green" } } }], "noValue": "Нет данных" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU в работе",
      "description": "Доля времени CPU без режима idle, усреднённая по ядрам.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"darim-system\",mode=\"idle\"}[5m])))", "legendFormat": "CPU", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "noValue": "Нет данных" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Доступная RAM",
      "description": "Память, доступная приложениям с учётом reclaimable cache.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "node_memory_MemAvailable_bytes{job=\"darim-system\"}", "legendFormat": "RAM", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "noValue": "Нет данных" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Время работы",
      "description": "Время с последней загрузки хоста.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "time() - node_boot_time_seconds{job=\"darim-system\"}", "legendFormat": "uptime", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "dtdurations", "noValue": "Нет данных" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Загрузка CPU по ядрам",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * (1 - avg by (cpu) (rate(node_cpu_seconds_total{job=\"darim-system\",mode=\"idle\"}[5m])))", "legendFormat": "CPU {{cpu}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Load average к числу ядер",
      "description": "Load average за 1, 5 и 15 минут, делённый на число CPU.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [
        { "expr": "node_load1{job=\"darim-system\"} / scalar(count(node_cpu_seconds_total{job=\"darim-system\",mode=\"idle\"}))", "legendFormat": "1 минута", "refId": "A" },
        { "expr": "node_load5{job=\"darim-system\"} / scalar(count(node_cpu_seconds_total{job=\"darim-system\",mode=\"idle\"}))", "legendFormat": "5 минут", "refId": "B" },
        { "expr": "node_load15{job=\"darim-system\"} / scalar(count(node_cpu_seconds_total{job=\"darim-system\",mode=\"idle\"}))", "legendFormat": "15 минут", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Использование RAM",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"darim-system\"} / node_memory_MemTotal_bytes{job=\"darim-system\"})", "legendFormat": "Занято", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Использование swap",
      "description": "Если swap на хосте отключён, панель показывает N/A.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * (1 - node_memory_SwapFree_bytes{job=\"darim-system\"} / node_memory_SwapTotal_bytes{job=\"darim-system\"}) and on(instance) (node_memory_SwapTotal_bytes{job=\"darim-system\"} > 0)", "legendFormat": "Swap занято", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "noValue": "N/A", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Корневой раздел: занято",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"darim-system\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|rootfs\"} / node_filesystem_size_bytes{job=\"darim-system\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|rootfs\"})", "legendFormat": "Занято", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Свободные inode корневого раздела",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * node_filesystem_files_free{job=\"darim-system\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|rootfs\"} / node_filesystem_files{job=\"darim-system\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|rootfs\"}", "legendFormat": "Свободно", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Дисковый ввод-вывод",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [
        { "expr": "sum by (device) (rate(node_disk_read_bytes_total{job=\"darim-system\",device=~\"^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+)$\"}[5m]))", "legendFormat": "Чтение {{device}}", "refId": "A" },
        { "expr": "sum by (device) (rate(node_disk_written_bytes_total{job=\"darim-system\",device=~\"^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+)$\"}[5m]))", "legendFormat": "Запись {{device}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Занятость дисков",
      "description": "Доля времени, когда физический диск выполнял ввод-вывод.",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "100 * clamp_max(rate(node_disk_io_time_seconds_total{job=\"darim-system\",device=~\"^(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+)$\"}[5m]), 1)", "legendFormat": "{{device}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Сеть физических интерфейсов",
      "description": "Показывает enp/eno/ens/eth/em/bond интерфейсы, исключая loopback, bridge и veth.",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [
        { "expr": "sum by (device) (rate(node_network_receive_bytes_total{job=\"darim-system\",device=~\"^(en[[:alnum:]_.-]+|eth[0-9]+|em[0-9]+|bond[0-9]+)$\"}[5m]))", "legendFormat": "Получено {{device}}", "refId": "A" },
        { "expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=\"darim-system\",device=~\"^(en[[:alnum:]_.-]+|eth[0-9]+|em[0-9]+|bond[0-9]+)$\"}[5m]))", "legendFormat": "Отправлено {{device}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Свободно на корневом разделе",
      "description": "Доступное место для пользователя на файловой системе /.",
      "gridPos": { "x": 0, "y": 44, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "darim-prometheus" },
      "targets": [{ "expr": "node_filesystem_avail_bytes{job=\"darim-system\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|rootfs\"}", "legendFormat": "Доступно", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "noValue": "Нет данных" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    }
  ]
}
