{
  "uid": "darim-host",
  "title": "Дарим — состояние сервера",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Доступная RAM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Загрузка CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Место на /",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Свободные inode",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_filesystem_files_free{mountpoint=\"/\"} / node_filesystem_files{mountpoint=\"/\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "OOM за 5 минут",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(node_vmstat_oom_kill[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Состояние API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"darim-health\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Освобождено за уборку",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "darim_cleanup_free_bytes_delta"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Часов с последней успешной уборки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - darim_cleanup_last_success_seconds) / 3600"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Доступность целей мониторинга",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Ошибки и пропуски уборки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "darim-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"darim_cleanup_failed|darim_cleanup_skipped\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
