@implements IAsyncDisposable
@inject Api Api
@inject IJSRuntime JS

@if (PhotoUrl is { } url && !unavailable)
{
    <img class="gift-photo" src="@url" alt="@Description" loading="lazy" decoding="async"
         referrerpolicy="no-referrer" @onerror="()=>unavailable=true" />
}
else if (PhotoVersion != null)
{
    <img @ref="image" class="gift-photo" alt="@Description" decoding="async" hidden />
}

@code {
    [Parameter] public GiftDto? Gift { get; set; }
    [Parameter] public PublicWishDto? PublicGift { get; set; }
    [Parameter] public string? ShareToken { get; set; }
    private string? PhotoUrl => Gift?.PhotoUrl ?? PublicGift?.PhotoUrl;
    private Guid? PhotoVersion => Gift?.PhotoVersion ?? PublicGift?.PhotoVersion;
    private string Description => $"Фото: {Gift?.Details.Title ?? PublicGift?.Details.Title}";
    private ElementReference image;
    private IJSObjectReference? loader;
    private bool unavailable, disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || PhotoUrl != null || PhotoVersion is not { } version || (Gift?.Id ?? PublicGift?.Id) is not { } id) return;
        var reference = await Api.WatchGiftPhoto(JS, image, id, version, ShareToken);
        if (disposed) await Release(reference);
        else loader = reference;
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (loader != null) await Release(loader);
    }

    private static async ValueTask Release(IJSObjectReference reference)
    {
        await reference.InvokeVoidAsync("dispose");
        await reference.DisposeAsync();
    }
}
