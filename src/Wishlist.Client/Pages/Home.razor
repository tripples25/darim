@namespace Wishlist.Client.Pages
@page "/"
@implements IAsyncDisposable
@inject Api Api
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@if(!ready){<StartupShell />}
else if(me==null){
 <main class="welcome">
  <a class="brand" href="/"><span class="brand-icon"><MudIcon Icon="@Icons.Material.Outlined.Redeem" /></span>дарим<span class="brand-dot">.</span></a>
  <div class="welcome-grid"><div><span class="eyebrow">ДЛЯ ВАШИХ БЛИЗКИХ ЛЮДЕЙ</span><h1>Меньше догадок.<br />Больше <em>радости.</em></h1><p>Все желания вашей компании в одном месте. Выбирайте подарки, дарите вместе и сохраняйте сюрприз.</p>
  @if(!string.IsNullOrEmpty(error)){<div class="error-box" role="alert">@error</div>}
  @if(info?.TelegramConfigured==true){<a class="primary-button login-button" href="/auth/login"><MudIcon Icon="@Icons.Material.Filled.Send" /> Войти через Telegram</a>}
  else{<p class="quiet-note">Telegram-вход появится после настройки бота и домена.</p>}
  @if(info?.DemoEnabled==true){<div class="demo-panel"><span>Попробовать в деморежиме</span><div>@for(var i=0;i<demoNames.Length;i++){var index=i;<button class="soft-button" disabled="@busy" @onclick="()=>DemoLogin(index)">@demoNames[i]</button>}</div><small>Только для локальной разработки</small></div>}
  <div class="welcome-points"><span>✓ Скрытая бронь</span><span>✓ Равные доли</span><span>✓ В браузере и Telegram</span></div>
  @if(info==null){<button class="soft-button" @onclick="Initialize">Повторить загрузку</button>}
  </div><div class="welcome-illustration" aria-hidden="true"><div class="floating-note note-one">То самое, что хочется ✨</div><div class="present-box">🎁</div><div class="floating-note note-two">Сюрприз под защитой 🔒</div><div class="circle c1"></div><div class="circle c2"></div></div></div>
 </main>
}
else{
 <div class="app-shell wishlist-shell">
 <aside class="sidebar">
  <a class="brand" href="/"><span class="brand-icon"><MudIcon Icon="@Icons.Material.Outlined.Redeem" /></span>дарим<span class="brand-dot">.</span></a>
  <div class="company-name">
   <MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Small" />
   <div><small>Текущая компания</small><strong>@(CurrentCompany?.Name ?? "Пока нет компаний")</strong></div>
  </div>
  <nav aria-label="Основная навигация">
   <button class="nav-item @(tab=="all"?"active":"")" aria-current="@(tab == "all" ? "page" : null)" @onclick='()=>SetTab("all")'><MudIcon Icon="@Icons.Material.Outlined.GridView" /> Все желания</button>
   <button class="nav-item @(tab=="mine"?"active":"")" aria-current="@(tab == "mine" ? "page" : null)" @onclick='()=>SetTab("mine")'><MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder" /> Мои желания</button>
   <button class="nav-item @(tab=="giving"?"active":"")" aria-current="@(tab == "giving" ? "page" : null)" @onclick='()=>SetTab("giving")'><MudIcon Icon="@Icons.Material.Outlined.Redeem" /> Я дарю <span class="nav-count">@givingGifts.Count(g=>!g.Archived)</span></button>
  </nav>
  <div class="sidebar-bottom"><button class="user-button" aria-label="Мой профиль" @onclick="OpenProfile"><span class="avatar">@Initial(me.User.Name)</span><span><strong>@me.User.Name</strong><small>Мой профиль</small></span><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" /></button><button class="logout-button" disabled="@busy" @onclick="Logout">Выйти</button></div>
 </aside>
 <main class="main-area">
  <header class="topbar">
   <a class="mobile-wordmark" href="/">дарим<span>.</span></a>
   <div class="top-actions">
   @if(Companies.Length>0){
    <select class="company-picker" aria-label="Текущая компания" value="@currentCompanyId" disabled="@busy" @onchange="SwitchCompany">
     @foreach(var company in Companies){<option value="@company.Id" selected="@(currentCompanyId==company.Id)">@company.Name</option>}
    </select>
   }
   <button class="soft-button company-manage" aria-label="Мои компании" @onclick="OpenCompanies"><MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Small" /><span>Компании</span></button>
   @if(CurrentCompany?.IsOrganizer==true){<button class="soft-button invite-button company-invite" aria-label="Пригласить" @onclick="OpenInvite"><MudIcon Icon="@Icons.Material.Outlined.PersonAddAlt" Size="Size.Small" /><span>Пригласить</span></button>}
   <button class="icon-button notice-button" aria-label="Уведомления" @onclick="OpenNotices"><MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" />@if(notices.Any(n=>!n.Read)){<span class="unread-dot"></span>}</button>
  </div></header>
  <div class="page-content">
   @if(!string.IsNullOrEmpty(error)){<div class="error-box" role="alert">@error <button @onclick="Refresh">Обновить</button></div>}
   @if(tab=="all"&&CurrentCompany==null){
    <section class="onboarding"><h1>Все желания</h1><p>Создайте компанию или присоединитесь по приглашению, чтобы увидеть желания друзей.</p><button class="primary-button" @onclick="OpenCompanies">Создать или присоединиться</button></section>
   }else{
    <header class="wishlist-cover">
     <div class="wishlist-cover-copy">
      <h1>@TabTitle</h1>
      <p>@TabDescription</p>
      @if(tab!="giving"){<div class="cover-actions"><button class="primary-button cover-add" disabled="@busy" @onclick="()=>OpenEditor(null)">
       <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" /> Добавить желание
      </button>
      @if(tab=="mine"){<button class="soft-button cover-share" disabled="@busy" @onclick="OpenShares"><MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" /> Поделиться списком</button>}
      </div>}
     </div>
    </header>
    @if(tab=="all"&&CurrentCompany is {} current){
     <div class="people-filter" role="group" aria-label="Фильтр по человеку">
      <button class="person-chip @(ownerFilter==""?"selected":"")" aria-pressed="@(ownerFilter == "" ? "true" : "false")" @onclick='()=>ownerFilter=""'>
       <span class="avatar all-avatar"><MudIcon Icon="@Icons.Material.Outlined.Groups" Size="Size.Small" /></span>Все
      </button>
      @foreach(var person in current.Members){
       var selected = ownerFilter == person.Id.ToString();
       <button class="person-chip @(selected ? "selected" : "")" aria-pressed="@(selected ? "true" : "false")" @onclick="()=>ownerFilter=person.Id.ToString()">
        <span class="avatar" aria-hidden="true">@Initial(person.Name)</span><span>@person.Name @(person.Id==me.User.Id?"(вы)":"")</span>
       </button>
      }
     </div>
    }
    <div class="filter-bar">
     <label class="search-box"><MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" /><input @ref="searchField" aria-label="Поиск желаний" placeholder="Поиск желаний" @bind="search" @bind:event="oninput" /></label>
     <button type="button" class="filter-toggle" aria-label="@(ActiveSelectFilters > 0 ? $"Фильтры, активно: {ActiveSelectFilters}" : "Фильтры")" aria-controls="wish-select-filters" aria-expanded="@(filtersExpanded ? "true" : "false")" @onclick="()=>filtersExpanded=!filtersExpanded">
      <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" /> Фильтры
      @if(ActiveSelectFilters > 0){<span class="filter-count" aria-hidden="true">@ActiveSelectFilters</span>}
     </button>
     <div id="wish-select-filters" class="select-filters @(filtersExpanded ? "expanded" : "")">
      <select aria-label="Праздник" @bind="occasion"><option value="">Все праздники</option>@foreach(var value in Occasions){<option value="@value">@value</option>}</select>
      @if(tab!="mine"){<select aria-label="Доступность" @bind="availability"><option value="">Все подарки</option><option value="free">Свободные</option><option value="split">Можно скинуться</option></select>}
      <select aria-label="Цена" @bind="priceFilter"><option value="">Любая цена</option><option value="5000">До 5 000 ₽</option><option value="10000">До 10 000 ₽</option><option value="20000">До 20 000 ₽</option></select>
     </div>
    </div>
    var visibleGifts = Filtered().ToArray();
    <div class="list-caption">
     <span role="status">@(showArchived ? "В архиве" : "В списке") <strong>@visibleGifts.Length</strong></span>
     <div class="list-caption-actions">
      @if(HasFilters && visibleGifts.Length > 0){<button type="button" class="filter-reset" @onclick="ClearFilters">Сбросить фильтры</button>}
      <label class="archive-toggle"><input type="checkbox" @bind="showArchived" /> Архив</label>
     </div>
    </div>
    @foreach(var group in visibleGifts.GroupBy(g=>g.Owner.Id)){
     var person=group.First().Owner;
     <section class="person-section" @key="person.Id">
      <div class="section-heading">
       <span class="avatar" aria-hidden="true">@Initial(person.Name)</span>
       <h2>@person.Name</h2>
       @if(person.Id == me.User.Id){<span class="section-self">Это вы</span>}
       <span class="section-count" aria-label="Желаний в группе">@group.Count()</span>
       <div class="section-line"></div>
      </div>
      <div class="gift-grid">@foreach(var gift in group){var isOwner=gift.Owner.Id==me.User.Id;<GiftCard @key="gift.Id" Gift="gift" IsOwner="isOwner" VisibilityText="@(isOwner?VisibilityLabel(gift):null)" OnAction="action=>GiftAction(gift,action)" />}</div>
     </section>
    }
    @if(visibleGifts.Length == 0){
     <div class="empty-state wishlist-empty">
      @if(HasFilters){
       <MudIcon Icon="@Icons.Material.Outlined.Search" />
       <h2>Ничего не нашлось</h2>
       <p>Измените запрос или сбросьте фильтры, чтобы увидеть весь список.</p>
       <button type="button" class="soft-button" @onclick="ClearFilters">Сбросить фильтры</button>
      }else if(showArchived){
       <MudIcon Icon="@Icons.Material.Outlined.Archive" />
       <h2>Архив пока пуст</h2>
       <p>Здесь появятся желания, которые отправили в архив.</p>
       <button type="button" class="soft-button" @onclick="()=>showArchived=false">Показать текущие желания</button>
      }else if(tab=="giving"){
       <MudIcon Icon="@Icons.Material.Outlined.Redeem" />
       <h2>Здесь будут ваши сюрпризы</h2>
       <p>Выберите подарок в общем списке, чтобы подарить его самому или вместе с друзьями.</p>
       <button type="button" class="soft-button" @onclick='()=>SetTab("all")'>Посмотреть все желания</button>
      }else{
       <MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder" />
       <h2>@(tab=="mine" ? "У вас пока нет желаний" : "В компании пока нет желаний")</h2>
       <p>@(tab=="mine"?"Добавьте то, что вас порадует, и выберите, кто сможет это увидеть.":"Добавьте то, что вас порадует, и друзья увидят это в списке.")</p>
       <button type="button" class="primary-button" disabled="@busy" @onclick="()=>OpenEditor(null)">Добавить первое желание</button>
      }
     </div>
    }
    <footer class="page-footer"><MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" Size="Size.Small" /> Брони на ваши желания скрыты от вас.</footer>
   }
  </div>
 </main></div>
}

<dialog id="app-dialog" class="@(dialog == "editor" ? "gift-editor-dialog" : null)" @onclose="DialogClosed" aria-labelledby="dialog-title">
 <div class="dialog-heading"><h2 id="dialog-title" tabindex="-1">@DialogTitle</h2><button class="icon-button" aria-label="Закрыть" @onclick="CloseDialog"><MudIcon Icon="@Icons.Material.Outlined.Close" /></button></div>
 <div class="dialog-content">
 @if(!string.IsNullOrEmpty(error)){<div class="error-box" role="alert">@error</div>}
 @if(dialog=="editor"){
  <form @onsubmit="SaveGift" @onsubmit:preventDefault class="editor-form">
   <div class="editor-fields">
    <label>Что хочется?<input @bind="editTitle" required maxlength="160" placeholder="Название подарка" autofocus /></label>
    <label>Ссылка на подарок<input type="url" @bind="editUrl" maxlength="2048" placeholder="https://" /></label>
   </div>
   <div class="editor-photo">
    @if(editPhotoPreview is {} preview){
     <img class="gift-photo" src="@preview" alt="Предпросмотр фотографии" />
    }else if(!removeEditPhoto && selected is { PhotoVersion: not null } existingPhoto){
     <GiftPhoto @key="existingPhoto.PhotoVersion" Gift="existingPhoto" />
    }
    <div class="editor-photo-actions">
     <label class="editor-photo-picker soft-button">
      <MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate" Size="Size.Small" />
      @(editPhoto!=null || (!removeEditPhoto && selected?.PhotoVersion!=null) ? "Заменить фото" : "Добавить фото")
      <InputFile @key="photoPickerKey" class="editor-photo-input" OnChange="ChooseGiftPhoto" accept="image/jpeg,image/png,image/webp" disabled="@(busy || readingEditPhoto)" />
     </label>
     @if(editPhoto!=null || (!removeEditPhoto && selected?.PhotoVersion!=null)){
      <button type="button" class="soft-button" disabled="@(busy || readingEditPhoto)" @onclick="RemoveGiftPhoto">Удалить фото</button>
     }
    </div>
    @if(readingEditPhoto){<small role="status">Читаем фото…</small>}
    @if(editPhotoError is {} photoError){<small class="error-box" role="alert">@photoError</small>}
   </div>
   @if(selected is null){
    <label class="guest-consent"><input type="checkbox" @bind="editUnlimited" /> Бесконечное желание</label>
    <small class="dialog-hint">Каждый даритель сможет забронировать это желание отдельно.</small>
   }else if(selected.Unlimited){
    <p class="dialog-hint">Бесконечное желание · каждый даритель бронирует его отдельно.</p>
   }
   @VisibilityFields
   <details class="editor-extras" open="@(selected != null)">
    <summary>Дополнительные параметры <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" /></summary>
    <div class="editor-fields">
     <div class="form-row">
      <label>Примерная цена, ₽<input type="number" @bind="editPrice" min="0" max="100000000" step="0.01" /></label>
      <label>Праздник<select aria-label="Праздник" @bind="editOccasion"><option>Без повода</option><option>День рождения</option><option>Новый год</option><option value="custom">Свой повод</option></select></label>
     </div>
     @if(editOccasion=="custom"){
      <label>Название повода<input @bind="editCustomOccasion" required maxlength="80" placeholder="Например, новоселье" /></label>
     }
     <label>Дата праздника<input type="date" @bind="editDate" /></label>
     <label>Подсказка для друзей<textarea @bind="editComment" maxlength="2000" rows="3" placeholder="Цвет, размер или почему это вас порадует"></textarea></label>
    </div>
   </details>
   <button class="primary-button full" disabled="@(busy || readingEditPhoto || !VisibilityValid)">@(busy?"Сохраняем…":"Сохранить желание")</button>
  </form>
 }
 else if(dialog=="visibility"&&selected!=null){
  <p>«@selected.Details.Title»</p>
  <form @onsubmit="SaveVisibility" @onsubmit:preventDefault>
   @VisibilityFields
   <button class="primary-button full" disabled="@(busy||!VisibilityValid)">Сохранить видимость</button>
  </form>
 }
 else if(dialog=="companies"){
  <div class="company-forms">
   <form @onsubmit="CreateCompany" @onsubmit:preventDefault><h3>Создать компанию</h3><label>Название<input @bind="companyName" required maxlength="100" placeholder="Например, Близкие люди" /></label><button class="primary-button" disabled="@busy">Создать</button></form>
   <form @onsubmit="JoinCompany" @onsubmit:preventDefault><h3>Присоединиться к компании</h3><label>Код или ссылка<input @bind="joinToken" required placeholder="Вставьте приглашение" /></label><button class="soft-button" disabled="@busy">Присоединиться</button></form>
  </div>
 }
 else if(dialog=="shares"){
  <p>По ссылке можно посмотреть желания без входа. Брони и участники компаний гостям скрыты.</p>
  <form class="share-create" @onsubmit="CreateShare" @onsubmit:preventDefault>
   <label>Какие желания открыть<select @bind="shareAudience"><option value="">Общие желания всех компаний</option>@foreach(var company in Companies){<option value="@company.Id">@company.Name</option>}</select></label>
   <label>Название ссылки для вас<input @bind="shareLabel" maxlength="80" placeholder="Необязательно" /></label>
   <button class="primary-button full" disabled="@busy">Создать ссылку</button>
  </form>
  <div class="share-links">
   @foreach(var link in shareLinks.Where(link=>link.Revoked==null)){
    <section class="share-link" @key="link.Id">
     <h3>@(link.Label??ShareAudienceName(link.CompanyId))</h3>
     <p class="dialog-hint">@ShareAudienceName(link.CompanyId) · @link.Created.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
     @if(issuedLinks.TryGetValue(link.Id,out var url)){
      <label>Ссылка<input readonly value="@url" /></label>
      <button type="button" class="soft-button" @onclick="()=>Copy(url)">Скопировать</button>
     }
     <button type="button" class="text-danger" disabled="@busy" @onclick="()=>RevokeShare(link.Id)">Отключить ссылку</button>
    </section>
   }
  </div>
 }
 else if(dialog=="split"&&selected!=null){
  <p>Разделим «@selected.Details.Title» на равные доли. Вы займёте первую, друзья смогут присоединиться.</p><form @onsubmit="StartSplit" @onsubmit:preventDefault><label>Количество участников<input type="number" min="2" max="@((CurrentCompany?.Members.Length??1)-1)" @bind="splitSlots" required /></label>@if(selected.Details.Price is {} amount&&splitSlots>0){<div class="split-preview">≈ @((amount/splitSlots).ToString("N0")) ₽ <span>с человека</span></div>}<p class="dialog-hint">Число долей фиксируется. Каждый занимает только одну. Деньги переводите друг другу самостоятельно.</p><button class="primary-button full" disabled="@(busy||CurrentCompany?.Members.Length is not >=3)">Распилить и занять долю</button></form>
 }
 else if(dialog=="details"&&selected is {} detail){
  <h3>@detail.Details.Title</h3><p class="dialog-hint">Получатель: @detail.Owner.Name · @detail.Details.Occasion</p>
  @if(detail.PhotoUrl!=null || detail.PhotoVersion!=null){<GiftPhoto @key="(detail.PhotoUrl, detail.PhotoVersion)" Gift="detail" />}
  @if(!string.IsNullOrWhiteSpace(detail.Details.Comment)){
   <p class="gift-description">@detail.Details.Comment</p>
  }
  @if(detail.Participation is { IsMine: true } p){
   @if(p.Participants!=null){<div class="participant-list">@foreach(var person in p.Participants){<div><span class="avatar">@Initial(person.Name)</span><span><strong>@person.Name</strong><small>@(person.Contact??"Контакт не указан")</small></span>@if(person.Id==p.CoordinatorId){<span class="coordinator-tag">координатор</span>}@if(person.Id==me!.User.Id){<span class="quiet-note">вы</span>}</div>}</div><p class="dialog-hint">Занято @p.Taken из @p.Slots. Координатор связывается с участниками и организует покупку.</p>}
   @if(detail.Original is {} original&&original!=detail.Details){<div class="change-warning"><strong>Желание изменилось после брони</strong><p>Изначально: @original.Title · @(original.Price?.ToString("N0")??"цена не указана") ₽ · @original.Occasion</p>@if(original.Url is {} oldUrl){<a href="@oldUrl" target="_blank" rel="noopener noreferrer">Исходная ссылка ↗</a>}<p>@original.Comment</p></div>}
   @if(detail.Archived){<p class="dialog-hint">Желание в архиве. История покупки сохранена.</p>}
   else if(p.Bought){<div class="success-box">✓ Подарок уже куплен. Осталось дождаться повода!</div>}
   else{
    @if(p.IsCoordinator){<button class="primary-button full" disabled="@(busy||(p.Mode=="split"&&p.Taken!=p.Slots))" @onclick='()=>Confirm("buy")'>Отметить купленным</button>
     @if(p.Mode=="split"&&p.Participants?.Length>1){<form class="transfer-form" @onsubmit="Transfer" @onsubmit:preventDefault><label>Передать координацию<select @bind="transferTo" required><option value="">Выберите участника</option>@foreach(var person in p.Participants.Where(x=>x.Id!=me!.User.Id)){<option value="@person.Id">@person.Name</option>}</select></label><button class="soft-button" disabled="@busy">Передать</button></form>}
     <button class="text-danger" disabled="@busy" @onclick='()=>Confirm("cancel")'>@(p.Mode=="split"?"Отменить весь распил":"Снять бронь")</button>
    }else if(p.Mode=="split"){<button class="soft-button full" disabled="@busy" @onclick='()=>Confirm("leave")'>Выйти из распила</button>}
   }
  }
 }
 else if(dialog=="confirm"){
  <p>@ConfirmText</p><div class="dialog-actions"><button class="soft-button" @onclick="CloseDialog">Назад</button><button class="primary-button" disabled="@busy" @onclick="ExecuteConfirmed">Подтвердить</button></div>
 }
 else if(dialog=="profile"){
  <form @onsubmit="SaveProfile" @onsubmit:preventDefault><label>Как вас зовут<input @bind="profileName" required maxlength="100" /></label><label>Как с вами связаться<input @bind="profileContact" maxlength="200" placeholder="@@username или другой контакт" /></label><p class="dialog-hint">Контакт увидят только участники совместного подарка, в котором вы участвуете. Он нужен для распила.</p><button class="primary-button full" disabled="@busy">Сохранить</button><button type="button" class="text-danger" disabled="@busy" @onclick="LogoutFromProfile">Выйти из аккаунта</button></form>
  @if(ohmywishesLoading || ohmywishesError != null || ohmywishes is { Enabled: true } or { Connected: true } or { Reconnect: true } or { WebApiEnabled: true }){
   <section class="ohmywishes-settings" aria-labelledby="ohmywishes-heading">
    <h3 id="ohmywishes-heading">Ohmywishes</h3>
    @if(ohmywishesLoading){<p class="dialog-hint" role="status">Проверяем подключение…</p>}
    else if(ohmywishes is not { } integration){
     <p class="error-box" role="alert">@ohmywishesError</p>
     <button type="button" class="soft-button" disabled="@busy" @onclick="LoadOhmywishesStatus">Проверить снова</button>
    }else{
    var showWebForm = integration.WebApiEnabled && !integration.Connected && !integration.Reconnect;
    @if(!showWebForm && ohmywishesError != null){<p class="error-box" role="alert">@ohmywishesError</p>}
    @if(integration.ListTitle is {} title){<p>Список «@title»</p>}
    @if(integration.LastSuccess is {} updated){<p class="dialog-hint">Последнее обновление: @updated.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>}
    @if(integration.WebApiConnected ? !integration.WebApiEnabled : !integration.Enabled && (integration.Connected || integration.Reconnect)){<p role="status">Синхронизация приостановлена.</p>}
    else if(integration.Reconnect){<p role="status">Доступ к Ohmywishes потерян. Подключитесь снова.</p>}
    else if(integration.Stale){<p role="status">Не удалось обновить список. Повторим попытку автоматически.</p>}
    else if(integration.ListId != null && integration.LastSuccess == null){<p role="status">Первое обновление скоро начнётся.</p>}
    else if(integration.ListId != null){<p class="dialog-hint">Новые желания появятся автоматически.</p>}
    @if(integration.Enabled && !integration.Connected){
     <p class="dialog-hint">@ImportVisibilityHint</p>
     @if(Api.IsMini){<button class="soft-button" @onclick="OpenOhmywishesInBrowser">Открыть «Дарим» в браузере</button>}
     else{<button class="soft-button" disabled="@busy" @onclick="ConnectOhmywishes">@(integration.Reconnect ? "Переподключить" : "Подключить Ohmywishes")</button>}
    }
    @if(showWebForm){
     <form @onsubmit="ConnectOhmywishesWeb" @onsubmit:preventDefault>
      <p id="ohmywishes-link-help" class="dialog-hint">Откройте нужный список в Ohmywishes и скопируйте ссылку через «Поделиться». Список должен открываться без входа. @ImportVisibilityHint</p>
      <label>Ссылка на ваш список Ohmywishes<input type="url" inputmode="url" autocapitalize="none" spellcheck="false" maxlength="512" aria-describedby="@(ohmywishesError == null ? "ohmywishes-link-help" : "ohmywishes-link-help ohmywishes-link-error")" @bind="ohmywishesWebLink" required /></label>
      @if(ohmywishesError != null){<p id="ohmywishes-link-error" class="error-box" role="alert">@ohmywishesError</p>}
      <button class="soft-button" disabled="@busy">Подключить по ссылке</button>
     </form>
    }
    @if(integration.Enabled && integration.Connected && !integration.WebApiConnected){
     @if(ohmywishesLists is null){<button class="soft-button" disabled="@busy" @onclick="LoadOhmywishesLists">Выбрать список</button>}
     else if(ohmywishesLists.Length == 0){<p class="dialog-hint">В Ohmywishes пока нет доступных для импорта списков.</p>}
     else{
      <form @onsubmit="SelectOhmywishesList" @onsubmit:preventDefault>
       <label>Список для импорта<select @bind="ohmywishesSelection" required><option value="">Выберите список</option>
        @foreach(var list in ohmywishesLists){<option value="@list.Id">@list.Title</option>}
       </select></label>
       <button class="soft-button" disabled="@busy">Синхронизировать список</button>
      </form>
     }
    }
    @if(integration.Connected || integration.Reconnect){
     <button class="text-danger" disabled="@busy" @onclick="DisconnectOhmywishes">Отключить Ohmywishes</button>
    }
    }
   </section>
  }
 }
 else if(dialog=="invite"){
  <p>Пригласите близких в «@CurrentCompany?.Name». Участник сможет смотреть общие желания и выбирать подарки.</p>
  @if(inviteLink!=null){<p class="dialog-hint">@(issuedInviteLimit is null?"Без ограничения числа вступлений.":issuedInviteLimit==1?"Одноразовая ссылка: для одного вступления.":$"Ссылка для {issuedInviteLimit} вступлений.") @if(miniInviteLink!=null){<text>Обе ссылки используют общий лимит.</text>}</p><label>Ссылка на сайт<input readonly value="@inviteLink" /></label><button class="primary-button full" @onclick="()=>Copy(inviteLink)">Скопировать ссылку</button>@if(miniInviteLink!=null){<label>Ссылка в Telegram<input readonly value="@miniInviteLink" /></label><button class="soft-button full" @onclick="()=>Copy(miniInviteLink)">Скопировать для Telegram</button>}}
  else{<p class="dialog-hint">Создание новой ссылки отключит предыдущие приглашения. Участники компании сохранят доступ.</p><label>Количество вступлений<select @bind="inviteLimitMode"><option value="one">Одноразовая</option><option value="limited">Указать количество</option><option value="unlimited">Без ограничения</option></select></label>@if(inviteLimitMode=="limited"){<label>Сколько человек могут вступить<input type="number" min="1" max="100" @bind="inviteLimit" /></label>}<button class="primary-button full" disabled="@busy" @onclick="MakeInvite">Создать новую ссылку</button>}
 }
 else if(dialog=="notices"){
  @if(notices.Length==0&&interests.Length==0){<div class="empty-state"><span>🔔</span><p>Пока всё спокойно. Здесь появятся изменения подарков, которые вы дарите.</p></div>}
  @foreach(var interest in interests){
   <div class="notice-item" @key="interest.Id">
    <p>Гость тоже хочет подарить «@interest.Title».</p>
    @if(interest.TelegramUsername is {} username){<p class="dialog-hint">Гость разрешил показать его Telegram: @username</p>}
    @if(interest.Notified){<small>Гостю сообщили, что подарок занят</small>}
    else{<button class="soft-button" disabled="@busy" @onclick="()=>NotifyGuest(interest.Id)">Сообщить гостю, что подарок занят</button>}
   </div>
  }
  @foreach(var notice in notices){<div class="notice-item"><p>@notice.Text</p><small>@notice.Created.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div>}
 }
 </div>
</dialog>

@code {
 RenderFragment VisibilityFields=>@<fieldset class="visibility-fields">
  <legend>Кто увидит желание</legend>
  <label><input type="radio" name="wish-visibility" value="private" checked="@(visibilityMode=="private")" @onchange='()=>visibilityMode="private"' /> Только я</label>
  <label><input type="radio" name="wish-visibility" value="selected" checked="@(visibilityMode=="selected")" disabled="@(Companies.Length==0)" @onchange='()=>visibilityMode="selected"' /> Выбранные компании</label>
  @if(visibilityMode=="selected"){
   <div class="visibility-company-options">
    @foreach(var company in Companies){<label><input type="checkbox" checked="@visibilityCompanies.Contains(company.Id)" @onchange="args=>ToggleVisibility(company.Id,args.Value is true)" /> @company.Name</label>}
   </div>
  }
  <label><input type="radio" name="wish-visibility" value="all" checked="@(visibilityMode=="all")" @onchange='()=>visibilityMode="all"' /> Все мои компании, включая будущие</label>
 </fieldset>;
}
